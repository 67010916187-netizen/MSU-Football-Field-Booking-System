@model MSUFootballBooking.Models.BookingViewModel
@{
    ViewData["Title"] = "เลือกระบบการจองสนาม";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>เลือกสนามและเวลา - ระบบจองสนามฟุตบอล มมส.</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Prompt', sans-serif; } </style>
</head>
<body class="bg-slate-900 text-white min-h-screen">
    <!-- Header Navbar -->
    <nav class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-2">
            <span class="text-2xl">⚽</span>
            <span class="font-bold text-amber-400 text-lg">MSU Football Booking</span>
        </div>
        <div class="flex items-center space-x-4 text-sm">
            <span class="text-slate-300">นิสิต: <strong class="text-amber-400">@ViewBag.UserEmail</strong></span>
            <a asp-action="Logout" class="bg-red-500/20 text-red-400 border border-red-500/30 px-3 py-1.5 rounded-lg hover:bg-red-500/30 transition">ออกจากระบบ</a>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto p-6">
        <h2 class="text-2xl font-bold mb-6 text-center text-slate-100">ขั้นตอนการจองสนามฟุตบอล</h2>

        <form asp-action="SelectField" method="post" class="space-y-8">
            <!-- ข้อ 1: เลือกสนาม -->
            <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                <h3 class="text-lg font-semibold text-amber-400 mb-4 flex items-center gap-2">
                    <span class="w-7 h-7 bg-amber-500/20 text-amber-400 rounded-full flex items-center justify-center text-sm">1</span> 
                    เลือกสนามฟุตบอล
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- สนามฟ้า -->
                    <label class="cursor-pointer">
                        <input type="radio" asp-for="FieldName" value="สนามฟ้า" class="peer hidden" required />
                        <div class="p-5 bg-slate-700/50 border-2 border-slate-600 rounded-xl text-center peer-checked:border-blue-500 peer-checked:bg-blue-950/40 hover:border-slate-500 transition">
                            <div class="w-12 h-12 bg-blue-500/20 text-blue-400 rounded-full mx-auto flex items-center justify-center text-xl font-bold mb-2">🟦</div>
                            <div class="font-bold text-lg text-blue-400">สนามฟ้า</div>
                            <div class="text-xs text-slate-400 mt-1">สนามฟุตบอลใหญ่ (หญ้าเทียม)</div>
                        </div>
                    </label>

                    <!-- สนามแดง -->
                    <label class="cursor-pointer">
                        <input type="radio" asp-for="FieldName" value="สนามแดง" class="peer hidden" />
                        <div class="p-5 bg-slate-700/50 border-2 border-slate-600 rounded-xl text-center peer-checked:border-red-500 peer-checked:bg-red-950/40 hover:border-slate-500 transition">
                            <div class="w-12 h-12 bg-red-500/20 text-red-400 rounded-full mx-auto flex items-center justify-center text-xl font-bold mb-2">🟥</div>
                            <div class="font-bold text-lg text-red-400">สนามแดง</div>
                            <div class="text-xs text-slate-400 mt-1">สนามฟุตบอลใหญ่ (หญ้าจริง)</div>
                        </div>
                    </label>

                    <!-- สนามเล็ก -->
                    <label class="cursor-pointer">
                        <input type="radio" asp-for="FieldName" value="สนามเล็ก" class="peer hidden" />
                        <div class="p-5 bg-slate-700/50 border-2 border-slate-600 rounded-xl text-center peer-checked:border-emerald-500 peer-checked:bg-emerald-950/40 hover:border-slate-500 transition">
                            <div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-full mx-auto flex items-center justify-center text-xl font-bold mb-2">🟩</div>
                            <div class="font-bold text-lg text-emerald-400">สนามเล็ก</div>
                            <div class="text-xs text-slate-400 mt-1">สนามฟุตซอล / 7 คน</div>
                        </div>
                    </label>
                </div>
            </div>

            <!-- ข้อ 2: เลือกวัน -->
            <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                <h3 class="text-lg font-semibold text-amber-400 mb-4 flex items-center gap-2">
                    <span class="w-7 h-7 bg-amber-500/20 text-amber-400 rounded-full flex items-center justify-center text-sm">2</span> 
                    เลือกวันที่
                </h3>
                <input asp-for="BookingDate" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full md:w-1/2 px-4 py-3 bg-slate-700 border border-slate-600 rounded-lg text-white focus:outline-none focus:border-amber-500" required />
            </div>

            <!-- ข้อ 3: เลือกเวลา (1 ชม., 06:00 - 22:00) -->
            <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
                <h3 class="text-lg font-semibold text-amber-400 mb-2 flex items-center gap-2">
                    <span class="w-7 h-7 bg-amber-500/20 text-amber-400 rounded-full flex items-center justify-center text-sm">3</span> 
                    เลือกเวลา (เปิดบริการ 06:00 - 22:00 น. / รอบละ 1 ชั่วโมง)
                </h3>
                <p class="text-xs text-slate-400 mb-4">* กำหนดเวลาเข้าใช้งานได้ครั้งละ 1 ชั่วโมงต่อรอบ</p>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    @{
                        string[] slots = new string[] {
                            "06:00 - 07:00", "07:00 - 08:00", "08:00 - 09:00", "09:00 - 10:00",
                            "10:00 - 11:00", "11:00 - 12:00", "12:00 - 13:00", "13:00 - 14:00",
                            "14:00 - 15:00", "15:00 - 16:00", "16:00 - 17:00", "17:00 - 18:00",
                            "18:00 - 19:00", "19:00 - 20:00", "20:00 - 21:00", "21:00 - 22:00"
                        };
                    }
                    @foreach (var time in slots)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" asp-for="TimeSlot" value="@time" class="peer hidden" required />
                            <div class="p-3 bg-slate-700/60 border border-slate-600 rounded-lg text-center text-sm peer-checked:bg-amber-500 peer-checked:text-slate-900 peer-checked:font-bold hover:border-amber-400 transition">
                                @time
                            </div>
                        </label>
                    }
                </div>
            </div>

            <!-- ปุ่มยืนยัน -->
            <div class="text-center pt-4">
                <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold px-8 py-3 rounded-xl shadow-lg transition duration-200">
                    ยืนยันการจองสนาม
                </button>
            </div>
        </form>
    </div>
</body>
</html>
